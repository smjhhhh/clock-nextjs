'use client'

import { useState, useEffect } from 'react'
import Link from 'next/link'

interface Question {
  no: number
  question: string
  answerOptions: {
    type: string
    answer: string
    score: string
  }[]
}

const questions: Question[] = [
  {
    no: 1,
    question: "在派对上，你通常会：",
    answerOptions: [
      { type: "A", answer: "与许多人交流，包括陌生人", score: "E" },
      { type: "B", answer: "与几个你认识的人交流", score: "I" }
    ]
  },
  {
    no: 2,
    question: "你更倾向于：",
    answerOptions: [
      { type: "A", answer: "现实一些，而不是爱幻想", score: "S" },
      { type: "B", answer: "爱幻想，而不是过于现实", score: "N" }
    ]
  },
  {
    no: 3,
    question: "以下哪种情况更糟：",
    answerOptions: [
      { type: "A", answer: "总是异想天开", score: "S" },
      { type: "B", answer: "墨守成规", score: "N" }
    ]
  },
  {
    no: 4,
    question: "你更欣赏：",
    answerOptions: [
      { type: "A", answer: "原则", score: "T" },
      { type: "B", answer: "情感", score: "F" }
    ]
  },
  {
    no: 5,
    question: "你更倾向于：",
    answerOptions: [
      { type: "A", answer: "有说服力的", score: "T" },
      { type: "B", answer: "感人的", score: "F" }
    ]
  },
  {
    no: 6,
    question: "你更喜欢哪种工作方式：",
    answerOptions: [
      { type: "A", answer: "按截止日期完成任务", score: "J" },
      { type: "B", answer: "随意什么时候都行", score: "P" }
    ]
  },
  {
    no: 7,
    question: "你做选择时更倾向于：",
    answerOptions: [
      { type: "A", answer: "比较谨慎", score: "J" },
      { type: "B", answer: "有点冲动", score: "P" }
    ]
  },
  {
    no: 8,
    question: "在聚会上你通常：",
    answerOptions: [
      { type: "A", answer: "待到很晚，越来越有活力", score: "E" },
      { type: "B", answer: "早早离开，感觉越来越疲倦", score: "I" }
    ]
  },
  {
    no: 9,
    question: "你更被哪种人吸引：",
    answerOptions: [
      { type: "A", answer: "理智的人", score: "S" },
      { type: "B", answer: "富有想象力的人", score: "N" }
    ]
  },
  {
    no: 10,
    question: "你对以下哪个更感兴趣：",
    answerOptions: [
      { type: "A", answer: "现实存在的事物", score: "S" },
      { type: "B", answer: "可能存在的事物", score: "N" }
    ]
  },
  {
    no: 11,
    question: "当评判他人时，你更容易被哪种因素影响：",
    answerOptions: [
      { type: "A", answer: "法律比具体情况更重要", score: "T" },
      { type: "B", answer: "具体情况比法律更重要", score: "F" }
    ]
  },
  {
    no: 12,
    question: "在与他人交往时，你倾向于：",
    answerOptions: [
      { type: "A", answer: "比较客观", score: "T" },
      { type: "B", answer: "更带有个人感情", score: "F" }
    ]
  },
  {
    no: 13,
    question: "你更倾向于：",
    answerOptions: [
      { type: "A", answer: "守时", score: "J" },
      { type: "B", answer: "从容", score: "P" }
    ]
  },
  {
    no: 14,
    question: "什么情况更让你烦恼：",
    answerOptions: [
      { type: "A", answer: "事情未完成", score: "J" },
      { type: "B", answer: "事情已完成", score: "P" }
    ]
  },
  {
    no: 15,
    question: "在你的社交圈中你是：",
    answerOptions: [
      { type: "A", answer: "了解他人动态", score: "E" },
      { type: "B", answer: "对新闻消息不太了解", score: "I" }
    ]
  },
  {
    no: 16,
    question: "在做日常事务时你更倾向于：",
    answerOptions: [
      { type: "A", answer: "按常规方式做", score: "S" },
      { type: "B", answer: "用你自己的方式做", score: "N" }
    ]
  },
  {
    no: 17,
    question: "作家应该：",
    answerOptions: [
      { type: "A", answer: "直接说自己想表达的意思", score: "S" },
      { type: "B", answer: "多用比喻来表达想法", score: "N" }
    ]
  },
  {
    no: 18,
    question: "你更喜欢哪一种：",
    answerOptions: [
      { type: "A", answer: "坚持统一的原则或方法", score: "T" },
      { type: "B", answer: "因情境改变想法或立场", score: "F" }
    ]
  },
  {
    no: 19,
    question: "你在做哪种判断时更舒服：",
    answerOptions: [
      { type: "A", answer: "逻辑判断", score: "T" },
      { type: "B", answer: "价值判断", score: "F" }
    ]
  },
  {
    no: 20,
    question: "你更希望事情是：",
    answerOptions: [
      { type: "A", answer: "尘埃落定，已经决定的", score: "J" },
      { type: "B", answer: "尚未确定，充满变数的", score: "P" }
    ]
  }
]

const mbtiNames: Record<string, string> = {
  'INTJ': '建筑师',
  'INTP': '逻辑学家',
  'ENTJ': '指挥官',
  'ENTP': '辩论家',
  'INFJ': '提倡者',
  'INFP': '调停者',
  'ENFJ': '主人公',
  'ENFP': '竞选者',
  'ISTJ': '物流师',
  'ISFJ': '守卫者',
  'ESTJ': '总经理',
  'ESFJ': '执政官',
  'ISTP': '鉴赏家',
  'ISFP': '探险家',
  'ESTP': '企业家',
  'ESFP': '表演者'
}

export default function MBTITest() {
  const [currentQuestion, setCurrentQuestion] = useState(0)
  const [answers, setAnswers] = useState<string[]>([])
  const [showResult, setShowResult] = useState(false)
  const [rewrittenQuestions, setRewrittenQuestions] = useState<Question[]>([])
  const [isLoading, setIsLoading] = useState(true)
  const [useOllama, setUseOllama] = useState(true)

  // 使用 Ollama 改写部分问题
  useEffect(() => {
    const rewriteQuestions = async () => {
      if (!useOllama) {
        setRewrittenQuestions(questions)
        setIsLoading(false)
        return
      }

      try {
        const rewritten = [...questions]

        // 随机选择 5-8 道题进行改写（不改写全部以保持测试稳定性）
        const numToRewrite = Math.floor(Math.random() * 4) + 5
        const indicesToRewrite = new Set<number>()

        while (indicesToRewrite.size < numToRewrite) {
          indicesToRewrite.add(Math.floor(Math.random() * questions.length))
        }

        // 批量改写选中的问题
        const rewritePromises = Array.from(indicesToRewrite).map(async (index) => {
          try {
            const response = await fetch('/api/rewrite-question', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                question: questions[index].question,
                answerOptions: questions[index].answerOptions,
              }),
            })

            if (response.ok) {
              const data = await response.json()
              rewritten[index] = {
                ...questions[index],
                question: data.question,
                answerOptions: data.answerOptions,
              }
            }
          } catch (error) {
            console.error(`改写问题 ${index} 失败:`, error)
          }
        })

        await Promise.all(rewritePromises)
        setRewrittenQuestions(rewritten)
      } catch (error) {
        console.error('改写问题失败:', error)
        setRewrittenQuestions(questions)
      } finally {
        setIsLoading(false)
      }
    }

    if (isLoading) {
      rewriteQuestions()
    }
  }, [useOllama, isLoading])

  const handleAnswer = (score: string) => {
    const newAnswers = [...answers, score]
    setAnswers(newAnswers)

    const currentQuestions = rewrittenQuestions.length > 0 ? rewrittenQuestions : questions

    if (currentQuestion < currentQuestions.length - 1) {
      setCurrentQuestion(currentQuestion + 1)
    } else {
      setShowResult(true)
    }
  }

  const calculateResult = () => {
    const scores = { E: 0, I: 0, S: 0, N: 0, T: 0, F: 0, J: 0, P: 0 }

    answers.forEach(answer => {
      scores[answer as keyof typeof scores]++
    })

    const ie = scores.E > scores.I ? 'E' : 'I'
    const sn = scores.S > scores.N ? 'S' : 'N'
    const tf = scores.T > scores.F ? 'T' : 'F'
    const jp = scores.J > scores.P ? 'J' : 'P'

    return `${ie}${sn}${tf}${jp}`
  }

  const getMBTIGroupColor = (type: string) => {
    const secondChar = type[1]
    const thirdChar = type[2]
    const fourthChar = type[3]

    if (secondChar === 'N' && thirdChar === 'T') {
      return { group: '分析师', color: 'from-purple-600 to-indigo-600', bg: 'bg-purple-50', border: 'border-purple-200' }
    }
    if (secondChar === 'N' && thirdChar === 'F') {
      return { group: '外交官', color: 'from-green-600 to-emerald-600', bg: 'bg-green-50', border: 'border-green-200' }
    }
    if (secondChar === 'S' && fourthChar === 'J') {
      return { group: '哨兵', color: 'from-blue-600 to-cyan-600', bg: 'bg-blue-50', border: 'border-blue-200' }
    }
    if (secondChar === 'S' && fourthChar === 'P') {
      return { group: '探险家', color: 'from-yellow-600 to-orange-600', bg: 'bg-yellow-50', border: 'border-yellow-200' }
    }
    return { group: '未知', color: 'from-gray-600 to-gray-600', bg: 'bg-gray-50', border: 'border-gray-200' }
  }

  const restart = () => {
    setCurrentQuestion(0)
    setAnswers([])
    setShowResult(false)
    setIsLoading(true)
    // 重新改写问题
    const rewriteQuestions = async () => {
      if (!useOllama) {
        setRewrittenQuestions(questions)
        setIsLoading(false)
        return
      }

      try {
        const rewritten = [...questions]
        const numToRewrite = Math.floor(Math.random() * 4) + 5
        const indicesToRewrite = new Set<number>()

        while (indicesToRewrite.size < numToRewrite) {
          indicesToRewrite.add(Math.floor(Math.random() * questions.length))
        }

        const rewritePromises = Array.from(indicesToRewrite).map(async (index) => {
          try {
            const response = await fetch('/api/rewrite-question', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                question: questions[index].question,
                answerOptions: questions[index].answerOptions,
              }),
            })

            if (response.ok) {
              const data = await response.json()
              rewritten[index] = {
                ...questions[index],
                question: data.question,
                answerOptions: data.answerOptions,
              }
            }
          } catch (error) {
            console.error(`改写问题 ${index} 失败:`, error)
          }
        })

        await Promise.all(rewritePromises)
        setRewrittenQuestions(rewritten)
      } catch (error) {
        console.error('改写问题失败:', error)
        setRewrittenQuestions(questions)
      } finally {
        setIsLoading(false)
      }
    }

    rewriteQuestions()
  }

  if (showResult) {
    const result = calculateResult()
    const typeName = mbtiNames[result] || '未知'
    const colors = getMBTIGroupColor(result)

    return (
      <div className="min-h-screen bg-gradient-to-br from-purple-100 via-pink-100 to-blue-100 flex items-center justify-center p-8">
        <div className="max-w-2xl w-full">
          <div className={`${colors.bg} rounded-3xl p-12 shadow-2xl border-2 ${colors.border}`}>
            <div className="text-center mb-8">
              <h1 className="text-5xl font-bold mb-4">测试完成！</h1>
              <div className={`inline-block bg-gradient-to-r ${colors.color} bg-clip-text text-transparent text-6xl font-bold mb-4`}>
                {result}
              </div>
              <p className="text-2xl text-gray-700 mb-2">{typeName}</p>
              <p className="text-xl text-gray-600">{colors.group}</p>
            </div>

            <div className="space-y-4 mb-8">
              <div className="bg-white rounded-xl p-6 shadow-md">
                <h3 className="font-bold text-lg mb-4">你的性格维度分布：</h3>
                <div className="space-y-3">
                  <div>
                    <div className="flex justify-between text-sm mb-1">
                      <span>外向 (E)</span>
                      <span>{answers.filter(a => a === 'E').length} 题</span>
                      <span>内向 (I)</span>
                    </div>
                    <div className="h-2 bg-gray-200 rounded-full overflow-hidden">
                      <div className="h-full bg-gradient-to-r from-orange-400 to-purple-400" style={{ width: `${(answers.filter(a => a === 'E').length / (answers.filter(a => a === 'E').length + answers.filter(a => a === 'I').length)) * 100}%` }}></div>
                    </div>
                  </div>
                  <div>
                    <div className="flex justify-between text-sm mb-1">
                      <span>感知 (S)</span>
                      <span>{answers.filter(a => a === 'S').length} 题</span>
                      <span>直觉 (N)</span>
                    </div>
                    <div className="h-2 bg-gray-200 rounded-full overflow-hidden">
                      <div className="h-full bg-gradient-to-r from-yellow-400 to-indigo-400" style={{ width: `${(answers.filter(a => a === 'S').length / (answers.filter(a => a === 'S').length + answers.filter(a => a === 'N').length)) * 100}%` }}></div>
                    </div>
                  </div>
                  <div>
                    <div className="flex justify-between text-sm mb-1">
                      <span>理性 (T)</span>
                      <span>{answers.filter(a => a === 'T').length} 题</span>
                      <span>情感 (F)</span>
                    </div>
                    <div className="h-2 bg-gray-200 rounded-full overflow-hidden">
                      <div className="h-full bg-gradient-to-r from-green-400 to-pink-400" style={{ width: `${(answers.filter(a => a === 'T').length / (answers.filter(a => a === 'T').length + answers.filter(a => a === 'F').length)) * 100}%` }}></div>
                    </div>
                  </div>
                  <div>
                    <div className="flex justify-between text-sm mb-1">
                      <span>计划 (J)</span>
                      <span>{answers.filter(a => a === 'J').length} 题</span>
                      <span>随性 (P)</span>
                    </div>
                    <div className="h-2 bg-gray-200 rounded-full overflow-hidden">
                      <div className="h-full bg-gradient-to-r from-teal-400 to-violet-400" style={{ width: `${(answers.filter(a => a === 'J').length / (answers.filter(a => a === 'J').length + answers.filter(a => a === 'P').length)) * 100}%` }}></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div className="flex gap-4 justify-center">
              <button
                onClick={restart}
                className="px-8 py-3 bg-gradient-to-r from-pink-500 to-rose-500 text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all hover:scale-105"
              >
                重新测试
              </button>
              <Link
                href="/dashboard"
                className="px-8 py-3 bg-gradient-to-r from-blue-500 to-cyan-500 text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all hover:scale-105"
              >
                查看我的主页
              </Link>
            </div>
          </div>
        </div>
      </div>
    )
  }

  // 如果还在加载，显示加载界面
  if (isLoading) {
    return (
      <div className="min-h-screen bg-gradient-to-br from-purple-100 via-pink-100 to-blue-100 flex items-center justify-center p-8">
        <div className="text-center">
          <div className="w-16 h-16 border-4 border-purple-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
          <h2 className="text-2xl font-bold text-gray-900 mb-2">正在准备测试...</h2>
          <p className="text-gray-600">
            {useOllama ? '使用 AI 为你生成个性化问题' : '加载测试题目'}
          </p>
        </div>
      </div>
    )
  }

  const currentQuestions = rewrittenQuestions.length > 0 ? rewrittenQuestions : questions
  const progress = ((currentQuestion + 1) / currentQuestions.length) * 100
  const question = currentQuestions[currentQuestion]

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-100 via-pink-100 to-blue-100 flex items-center justify-center p-8">
      <div className="max-w-3xl w-full">
        {/* Header */}
        <div className="text-center mb-8">
          <h1 className="text-4xl font-bold text-gray-900 mb-2">MBTI 性格测试</h1>
          <p className="text-gray-600 mb-4">
            {useOllama ? '✨ AI 个性化测试' : '探索你的性格类型'}
          </p>
          <div className="inline-flex items-center gap-2 bg-white/50 px-4 py-2 rounded-full">
            <span className="text-sm text-gray-600">AI 模式</span>
            <button
              onClick={() => {
                setUseOllama(!useOllama)
                setIsLoading(true)
                setCurrentQuestion(0)
                setAnswers([])
              }}
              className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${
                useOllama ? 'bg-purple-500' : 'bg-gray-300'
              }`}
            >
              <span
                className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${
                  useOllama ? 'translate-x-6' : 'translate-x-1'
                }`}
              />
            </button>
          </div>
        </div>

        {/* Progress Bar */}
        <div className="mb-8">
          <div className="flex justify-between text-sm text-gray-600 mb-2">
            <span>进度</span>
            <span>{currentQuestion + 1} / {currentQuestions.length}</span>
          </div>
          <div className="h-3 bg-gray-200 rounded-full overflow-hidden">
            <div
              className="h-full bg-gradient-to-r from-pink-500 to-purple-500 transition-all duration-300"
              style={{ width: `${progress}%` }}
            ></div>
          </div>
        </div>

        {/* Question Card */}
        <div className="bg-white rounded-3xl p-10 shadow-2xl border-2 border-gray-100">
          <div className="mb-8">
            <span className="inline-block px-4 py-2 bg-gradient-to-r from-pink-500 to-purple-500 text-white rounded-full text-sm font-semibold mb-4">
              问题 {question.no}
            </span>
            <h2 className="text-2xl font-bold text-gray-900">
              {question.question}
            </h2>
          </div>

          <div className="space-y-4">
            {question.answerOptions.map((option, index) => (
              <button
                key={index}
                onClick={() => handleAnswer(option.score)}
                className="w-full p-6 text-left bg-gradient-to-r from-gray-50 to-gray-100 hover:from-pink-50 hover:to-purple-50 border-2 border-gray-200 hover:border-pink-300 rounded-2xl transition-all hover:scale-105 hover:shadow-lg group"
              >
                <div className="flex items-center gap-4">
                  <div className="w-10 h-10 rounded-full bg-gradient-to-r from-pink-500 to-purple-500 flex items-center justify-center text-white font-bold flex-shrink-0">
                    {option.type}
                  </div>
                  <p className="text-lg text-gray-800 group-hover:text-gray-900 font-medium">
                    {option.answer}
                  </p>
                </div>
              </button>
            ))}
          </div>
        </div>

        {/* Back Button */}
        <div className="mt-6 text-center">
          <Link href="/" className="text-gray-600 hover:text-gray-900 transition-colors">
            ← 返回首页
          </Link>
        </div>
      </div>
    </div>
  )
}
